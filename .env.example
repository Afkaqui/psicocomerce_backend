# Espacio Resiliente - Backend
# Copia a .env y completa los valores. NUNCA subas .env a git.

# Base de datos (usar hostname postgres_db dentro de Docker)
DATABASE_URL=postgresql://admin:password@postgres_db:5432/espacioresiliente_db

# Auth
JWT_SECRET=cambiar-por-secreto-aleatorio-largo

# Server
PORT=3001
FRONTEND_URL=https://testpsico.lucyscan.com

# Culqi (pasarela de pagos)
CULQI_PUBLIC_KEY=pk_test_xxx
CULQI_SECRET_KEY=sk_test_xxx

# Resend (emails transaccionales)
RESEND_API_KEY=re_xxx
EMAIL_FROM=noreply@espacioresiliente.com
ADMIN_EMAIL=admin@espacioresiliente.com

# Google Calendar (opcional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
